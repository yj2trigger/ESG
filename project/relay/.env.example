# SmartThings PAT (developer.smartthings.com)
SMARTTHINGS_PAT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 기기 매핑: SMARTTHINGS_DEVICE_{ESG_machine_id}=SmartThings_device_uuid
SMARTTHINGS_DEVICE_1=7c805ce1-ae39-4c1c-9868-6c40f646cb0d

# Fly.io secrets의 IOT_DEVICE_KEY와 동일한 값
IOT_DEVICE_KEY=your-secret-key-here

# 선택사항 (기본값 사용 시 생략 가능)
ESG_BASE_URL=https://esg-laundry-checker.fly.dev
START_THRESHOLD_W=10
STOP_THRESHOLD_W=5
POLL_INTERVAL_SEC=60
